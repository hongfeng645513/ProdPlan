{
  "platform": {
    "apiRuntime": "node:20"
  },
  "routes": [
    {
      "route": "/.auth/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/health",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/*",
      "methods": ["POST", "PUT", "DELETE", "PATCH"],
      "allowedRoles": ["editor"]
    },
    {
      "route": "/api/*",
      "allowedRoles": ["planner", "editor"]
    },
    {
      "route": "/*",
      "allowedRoles": ["planner", "editor"]
    }
  ],
  "responseOverrides": {
    "401": {
      "statusCode": 302,
      "redirect": "/.auth/login/aad"
    },
    "403": {
      "statusCode": 302,
      "redirect": "/.auth/login/aad"
    },
    "404": {
      "rewrite": "/index.html"
    }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/assets/*"]
  }
}
